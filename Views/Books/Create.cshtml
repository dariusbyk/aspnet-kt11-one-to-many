@model BookForm
<h1>Добавление книги</h1>
@if (!ViewBag.HasAuthors)
{
    <p>Сначала <a asp-controller="Authors" asp-action="Create">добавьте автора</a>.</p>
}
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="error"></div>
    <p><label asp-for="Title">Название</label><input asp-for="Title" /></p>
    <p>
        <label asp-for="AuthorId">Автор</label>
        <select asp-for="AuthorId" asp-items="ViewBag.Authors">
            <option value="0">Выберите автора</option>
        </select>
    </p>
    <button type="submit">Сохранить</button>
    <a asp-action="Index">Отмена</a>
</form>
