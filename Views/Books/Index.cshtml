@model List<Book>
<h1>Книги</h1>
<p><a asp-action="Create">Добавить книгу</a></p>
<table>
    <tr><th>Название</th><th>Автор</th><th>Действия</th></tr>
    @foreach (Book book in Model)
    {
        <tr>
            <td>@book.Title</td><td>@book.Author.Name</td>
            <td>
                <a asp-action="Details" asp-route-id="@book.BookId">Просмотр</a>
                <a asp-action="Edit" asp-route-id="@book.BookId">Редактировать</a>
                <a asp-action="Delete" asp-route-id="@book.BookId">Удалить</a>
            </td>
        </tr>
    }
</table>
